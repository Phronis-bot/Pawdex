# Copy to /opt/pawdex/.env on the server and fill in.
# Never commit the real .env.

# The domain pointing at this server (an A record), e.g. api.pawdex.app
PAWDEX_DOMAIN=

# Database password: generate one on the server with   openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional Telegram bot (Mini App). Token from @BotFather; the webhook secret is any
# random string, e.g.   openssl rand -hex 24
PAWDEX_TELEGRAM_BOT_TOKEN=
PAWDEX_TELEGRAM_WEBHOOK_SECRET=
