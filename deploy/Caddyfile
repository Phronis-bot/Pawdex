{$PAWDEX_DOMAIN} {
	encode gzip
	# Access log (docker compose logs caddy), to see what clients like the Mini App request.
	log
	# Photos are up to 15 MB; leave a little headroom for the multipart envelope.
	request_body {
		max_size 20MB
	}

	# The Flutter web build: the Telegram Mini App.
	redir /play /play/
	handle_path /play/* {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	handle {
		reverse_proxy api:8000
	}
}
